# Reference only. Generate your private configuration: python scripts/setup_env.py
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_NAME=File Storage
APP_HOST=127.0.0.1
APP_PORT=8000
JWT_EXPIRES_MIN=1440
MAX_UPLOAD_MB=50
# Relative storage/database paths resolve from backend/, independent of your terminal directory.
STORAGE_DIR=.data/storage
DATABASE_URL=sqlite:///.data/data.db
ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf,text/plain
